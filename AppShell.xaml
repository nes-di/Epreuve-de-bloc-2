<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AnnuaireEntreprise.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AnnuaireEntreprise.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="Annuaire Entreprise">

    <!-- Menu Latéral (Flyout) -->
    <FlyoutItem Title="Consultation" Icon="dotnet_bot.png">
        <ShellContent 
            Title="Liste des Salariés" 
            ContentTemplate="{DataTemplate views:MainPage}" 
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Administration" Icon="dotnet_bot.png">
        <ShellContent 
            Title="Connexion" 
            ContentTemplate="{DataTemplate views:LoginPage}" 
            Route="LoginPage" />
        
        <ShellContent 
            Title="Gestion Salariés" 
            ContentTemplate="{DataTemplate views:AdminPage}" 
            Route="AdminPage" />

        <ShellContent 
            Title="Gestion Services" 
            ContentTemplate="{DataTemplate views:ServicesPage}" 
            Route="ServicesPage" />

        <ShellContent 
            Title="Gestion Sites" 
            ContentTemplate="{DataTemplate views:SitesPage}" 
            Route="SitesPage" />
    </FlyoutItem>

</Shell>