<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AnnuaireEntreprise.Models"
             x:Class="AnnuaireEntreprise.Views.AdminPage"
             Title="Gestion des Salariés">

    <Grid RowDefinitions="Auto, *" Padding="20">
        
        <!-- Bouton Ajouter -->
        <Button Grid.Row="0" Text="➕ Ajouter un salarié" 
                Command="{Binding AddCommand}"
                BackgroundColor="#28A745" TextColor="White" Margin="0,0,0,20" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Salaries}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Salarie">
                    <Frame Margin="0,0,0,10" Padding="10" BackgroundColor="#1E1E1E">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding NomComplet}" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="{Binding Service.Nom}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="10">
                                <Button Text="✏️" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent"/>
                                <Button Text="🗑️" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>