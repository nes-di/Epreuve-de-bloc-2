<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AnnuaireEntreprise.Models"
             xmlns:vm="clr-namespace:AnnuaireEntreprise.ViewModels"
             x:Class="AnnuaireEntreprise.Views.AdminPage"
             Title="Gestion des Salariés">

    <ContentPage.BindingContext>
        <vm:AdminViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *" Padding="20">
        
        <!-- En-tête avec les boutons d'action -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Button Text="➕ Ajouter un salarié" Command="{Binding AddCommand}" BackgroundColor="#28A745" TextColor="White" />
            <Button Text="☁️ Importer 10 Salariés (API)" Command="{Binding ImportApiCommand}" BackgroundColor="#007BFF" TextColor="White" />
        </HorizontalStackLayout>

        <!-- Liste des Salariés -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Salaries}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Salarie">
                    <!-- Remplacement de Frame par Border pour éviter les avertissements .NET 10 (Optionnel mais recommandé) -->
                    <Border Margin="0,0,0,10" Padding="10" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding NomComplet}" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="{Binding Service.Nom}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="10">
                                <Button Text="✏️" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="Transparent"
                                        FontSize="18"/>
                                <Button Text="🗑️" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="Transparent"
                                        FontSize="18"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>