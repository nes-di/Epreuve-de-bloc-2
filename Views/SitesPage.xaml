<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AnnuaireEntreprise.ViewModels"
             xmlns:models="clr-namespace:AnnuaireEntreprise.Models"
             x:Class="AnnuaireEntreprise.Views.SitesPage"
             Title="Gestion des Sites">

    <ContentPage.BindingContext>
        <vm:SitesViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="15">
        
        <!-- Ajout d'une ville -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Entry Placeholder="Nom de la ville" 
                   Text="{Binding NouvelleVille}" 
                   WidthRequest="250" />
            <Button Text="Ajouter" 
                    Command="{Binding AddCommand}" 
                    BackgroundColor="#28A745" />
        </HorizontalStackLayout>

        <!-- Liste des villes -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Sites}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Site">
                    <Grid ColumnDefinitions="*, Auto" Padding="10">
                        <Label Text="{Binding Ville}" VerticalOptions="Center" FontSize="16" />
                        <Button Grid.Column="1" Text="🗑️" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SitesViewModel}}, Path=DeleteCommand}" 
                                CommandParameter="{Binding .}"
                                BackgroundColor="Transparent" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>