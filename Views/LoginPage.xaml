<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AnnuaireEntreprise.ViewModels"
             x:Class="AnnuaireEntreprise.Views.LoginPage"
             Title="Connexion Admin">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="20" Padding="40" VerticalOptions="Center">
        <Label Text="🔑 Administration" FontSize="28" HorizontalOptions="Center" FontAttributes="Bold" />
        
        <Entry Placeholder="Entrez le mot de passe" 
               IsPassword="True" 
               Text="{Binding Password}" 
               HorizontalOptions="Center" WidthRequest="300" />

        <Label Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" />

        <Button Text="Déverrouiller" 
                Command="{Binding LoginCommand}" 
                BackgroundColor="#569CD6" 
                TextColor="White" WidthRequest="200" />
    </VerticalStackLayout>
</ContentPage>